# Copia este archivo a ".env" y coloca tu API key real de Apollo.io.
# NUNCA subas el archivo ".env" al repositorio (ya está en .gitignore).
APOLLO_API_KEY=tu_api_key_de_apollo_aqui

# Puerto opcional para el servidor local
PORT=3000

# Ponlo en "true" para ver en los logs del servidor la respuesta cruda
# de Apollo (búsqueda de personas y /people/match), útil para depurar.
APOLLO_DEBUG=false
